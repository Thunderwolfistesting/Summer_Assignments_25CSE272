   "source": [
    "115. Write a program to Create menu-driven string operations system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c5ad9e2f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "========== STRING MENU ==========\n",
      "1. Display String\n",
      "2. Concatenate String\n",
      "3. Find Length\n",
      "4. Convert to Uppercase\n",
      "5. Convert to Lowercase\n",
      "6. Reverse String\n",
      "7. Exit\n",
      "Current String: Python\n",
      "\n",
      "========== STRING MENU ==========\n",
      "1. Display String\n",
      "2. Concatenate String\n",
      "3. Find Length\n",
      "4. Convert to Uppercase\n",
      "5. Convert to Lowercase\n",
      "6. Reverse String\n",
      "7. Exit\n",
      "Thank you! Program terminated.\n"
     ]
    }
   ],
   "source": [
    "text_buffer = input(\"Enter the initial string: \")\n",
    "\n",
    "while True:\n",
    "    print(\"\\n========== STRING MENU ==========\")\n",
    "    print(\"1. Display String\")\n",
    "    print(\"2. Concatenate String\")\n",
    "    print(\"3. Find Length\")\n",
    "    print(\"4. Convert to Uppercase\")\n",
    "    print(\"5. Convert to Lowercase\")\n",
    "    print(\"6. Reverse String\")\n",
    "    print(\"7. Exit\")\n",
    "\n",
    "    menu_selection = int(input(\"\\nEnter your choice: \"))\n",
    "\n",
    "    if menu_selection == 1:\n",
    "        print(f\"Current String: {text_buffer}\")\n",
    "\n",
    "    elif menu_selection == 2:\n",
    "        append_text = input(\"Enter another string: \")\n",
    "        text_buffer = text_buffer + append_text\n",
    "        print(f\"Updated String: {text_buffer}\")\n",
    "\n",
    "    elif menu_selection == 3:\n",
    "        character_count = 0\n",
    "        for character in text_buffer:\n",
    "            character_count += 1\n",
    "        print(f\"Length of string = {character_count}\")\n",
    "\n",
    "    elif menu_selection == 4:\n",
    "        print(f\"Uppercase String: {text_buffer.upper()}\")\n",
    "\n",
    "    elif menu_selection == 5:\n",
    "        print(f\"Lowercase String: {text_buffer.lower()}\")\n",
    "\n",
    "    elif menu_selection == 6:\n",
    "        inverted_text = \"\"\n",
    "        negative_index = -1\n",
    "        while True:\n",
    "            try:\n",
    "                inverted_text += text_buffer[negative_index]\n",
    "                negative_index -= 1\n",
    "            except IndexError:\n",
    "                break\n",
    "        print(f\"Reversed String: {inverted_text}\")\n",
    "\n",
    "    elif menu_selection == 7:\n",
    "        print(\"Thank you! Program terminated.\")\n",
    "        break\n",
    "\n",
    "    else:\n",
    "        print(\"Invalid choice! Please enter a number between 1 and 7.\")"
   ]
  },
