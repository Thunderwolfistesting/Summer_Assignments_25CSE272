   "source": [
    "113. Write a program to Create menu-driven calculator."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0bd8f1e9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "===== Calculator =====\n",
      "1. Addition\n",
      "2. Subtraction\n",
      "3. Multiplication\n",
      "4. Division\n",
      "Result = 25.0\n"
     ]
    }
   ],
   "source": [
    "print(\"===== Calculator =====\")\n",
    "print(\"1. Addition\")\n",
    "print(\"2. Subtraction\")\n",
    "print(\"3. Multiplication\")\n",
    "print(\"4. Division\")\n",
    "\n",
    "operation_choice = int(input(\"Enter your choice (1-4): \"))\n",
    "\n",
    "first_num = float(input(\"Enter first number: \"))\n",
    "second_num = float(input(\"Enter second number: \"))\n",
    "\n",
    "if operation_choice == 1:\n",
    "    calculation_result = first_num + second_num\n",
    "    print(f\"Result = {calculation_result}\")\n",
    "\n",
    "elif operation_choice == 2:\n",
    "    calculation_result = first_num - second_num\n",
    "    print(f\"Result = {calculation_result}\")\n",
    "\n",
    "elif operation_choice == 3:\n",
    "    calculation_result = first_num * second_num\n",
    "    print(f\"Result = {calculation_result}\")\n",
    "\n",
    "elif operation_choice == 4:\n",
    "    if second_num != 0:\n",
    "        calculation_result = first_num / second_num\n",
    "        print(f\"Result = {calculation_result}\")\n",
    "    else:\n",
    "        print(\"Division by zero is not allowed.\")\n",
    "\n",
    "else:\n",
    "    print(\"Invalid Choice.\")"
   ]
  },
