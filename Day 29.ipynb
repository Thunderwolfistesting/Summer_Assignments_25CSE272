    "116. Write a program to Create inventory management system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d6bfb29d",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "========== INVENTORY MANAGEMENT SYSTEM ==========\n",
      "1. Add Product\n",
      "2. Display Inventory\n",
      "3. Search Product\n",
      "4. Update Product\n",
      "5. Delete Product\n",
      "6. Exit\n",
      "Monitor added successfully!\n",
      "\n",
      "========== INVENTORY MANAGEMENT SYSTEM ==========\n",
      "1. Add Product\n",
      "2. Display Inventory\n",
      "3. Search Product\n",
      "4. Update Product\n",
      "5. Delete Product\n",
      "6. Exit\n",
      "Thank you! Exiting program...\n"
     ]
    }
   ],
   "source": [
    "stock_ledger = {}\n",
    "\n",
    "while True:\n",
    "    print(\"\\n========== INVENTORY MANAGEMENT SYSTEM ==========\")\n",
    "    print(\"1. Add Product\")\n",
    "    print(\"2. Display Inventory\")\n",
    "    print(\"3. Search Product\")\n",
    "    print(\"4. Update Product\")\n",
    "    print(\"5. Delete Product\")\n",
    "    print(\"6. Exit\")\n",
    "\n",
    "    try:\n",
    "        menu_selection = int(input(\"\\nEnter your choice: \"))\n",
    "    except ValueError:\n",
    "        print(\"Please enter a valid number!\")\n",
    "        continue\n",
    "\n",
    "    if menu_selection == 1:\n",
    "        item_name = input(\"Enter product name: \")\n",
    "        item_qty = int(input(\"Enter quantity: \"))\n",
    "        item_price = float(input(\"Enter price: \"))\n",
    "\n",
    "        stock_ledger[item_name] = {\n",
    "            \"Quantity\": item_qty,\n",
    "            \"Price\": item_price\n",
    "        }\n",
    "        print(f\"{item_name} added successfully!\")\n",
    "\n",
    "    elif menu_selection == 2:\n",
    "        if stock_ledger == {}:\n",
    "            print(\"Inventory is empty!\")\n",
    "        else:\n",
    "            print(\"\\n----------- INVENTORY -----------\")\n",
    "            print(\"Product\\t\\tQuantity\\tPrice\")\n",
    "            print(\"----------------------------------------\")\n",
    "            for item_name, metrics in stock_ledger.items():\n",
    "                print(f\"{item_name}\\t\\t{metrics['Quantity']}\\t\\t{metrics['Price']}\")\n",
    "\n",
    "    elif menu_selection == 3:\n",
    "        item_name = input(\"Enter product name to search: \")\n",
    "        if item_name in stock_ledger:\n",
    "            print(f\"\\nProduct : {item_name}\")\n",
    "            print(f\"Quantity: {stock_ledger[item_name]['Quantity']}\")\n",
    "            print(f\"Price   : {stock_ledger[item_name]['Price']}\")\n",
    "        else:\n",
    "            print(\"Product not found!\")\n",
    "\n",
    "    elif menu_selection == 4:\n",
    "        item_name = input(\"Enter product name to update: \")\n",
    "        if item_name in stock_ledger:\n",
    "            item_qty = int(input(\"Enter new quantity: \"))\n",
    "            item_price = float(input(\"Enter new price: \"))\n("\n",
    "            stock_ledger[item_name][\"Quantity\"] = item_qty\n",
    "            stock_ledger[item_name][\"Price\"] = item_price\n",
    "            print(f\"{item_name} updated successfully!\")\n",
    "        else:\n",
    "            print(\"Product not found!\")\n",
    "\n",
    "    elif menu_selection == 5:\n",
    "        item_name = input(\"Enter product name to delete: \")\n",
    "        if item_name in stock_ledger:\n",
    "            del stock_ledger[item_name]\n",
    "            print(f\"{item_name} deleted successfully!\")\n",
    "        else:\n",
    "            print(\"Product not found!\")\n",
    "\n",
    "    elif menu_selection == 6:\n",
    "        print(\"Thank you! Exiting program...\")\n",
    "        break\n",
    "\n",
    "    else:\n",
    "        print(\"Invalid choice! Please choose between 1 and 6.\")"
   ]
  }
