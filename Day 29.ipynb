   "source": [
    "114. Write a program to Create menu-driven array operations system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ae1a32e5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "========== ARRAY MENU ==========\n",
      "1. Insert Element\n",
      "2. Display Elements\n",
      "3. Search Element\n",
      "4. Update Element\n",
      "5. Delete Element\n",
      "6. Exit\n",
      "12 inserted successfully!\n",
      "\n",
      "========== ARRAY MENU ==========\n",
      "1. Insert Element\n",
      "2. Display Elements\n",
      "3. Search Element\n",
      "4. Update Element\n",
      "5. Delete Element\n",
      "6. Exit\n",
      "Thank you! Program terminated.\n"
     ]
    }
   ],
   "source": [
    "data_store = []\n",
    "\n",
    "while True:\n",
    "    print(\"\\n========== ARRAY MENU ==========\")\n",
    "    print(\"1. Insert Element\")\n",
    "    print(\"2. Display Elements\")\n",
    "    print(\"3. Search Element\")\n",
    "    print(\"4. Update Element\")\n",
    "    print(\"5. Delete Element\")\n",
    "    print(\"6. Exit\")\n",
    "\n",
    "    menu_selection = int(input(\"\\nEnter your choice: \"))\n",
    "\n",
    "    if menu_selection == 1:\n",
    "        new_item = int(input(\"Enter element to insert: \"))\n",
    "        data_store += [new_item]\n",
    "        print(f\"{new_item} inserted successfully!\")\n",
    "\n",
    "    elif menu_selection == 2:\n",
    "        if data_store == []:\n",
    "            print(\"Array is empty!\")\n",
    "        else:\n",
    "            print(\"\\nArray Elements:\")\n",
    "            loop_index = 0\n",
    "            while True:\n",
    "                try:\n",
    "                    print(f\"Index {loop_index} : {data_store[loop_index]}\")\n",
    "                    loop_index += 1\n",
    "                except IndexError:\n",
    "                    break\n",
    "\n",
    "    elif menu_selection == 3:\n",
    "        if data_store == []:\n",
    "            print(\"Array is empty!\")\n",
    "        else:\n",
    "            target_key = int(input(\"Enter element to search: \"))\n",
    "            loop_index = 0\n",
    "            item_found = False\n",
    "\n",
    "            while True:\n",
    "                try:\n",
    "                    if data_store[loop_index] == target_key:\n",
    "                        print(f\"{target_key} found at index {loop_index}.\")\n",
    "                        item_found = True\n",
    "                        break\n",
    "                    loop_index += 1\n",
    "                except IndexError:\n",
    "                    break\n",
    "\n",
    "            if not item_found:\n",
    "                print(f\"{target_key} not found in the array.\")\n",
    "\n",
    "    elif menu_selection == 4:\n",
    "        if data_store == []:\n",
    "            print(\"Array is empty!\")\n",
    "        else:\n",
    "            target_index = int(input(\"Enter index to update: \"))\n",
    "            try:\n",
    "                print(f\"Current value = {data_store[target_index]}\")\n",
    "                updated_value = int(input(\"Enter new value: \"))\n",
    "                data_store[target_index] = updated_value\n",
    "                print(f\"Index {target_index} updated successfully!\")\n",
    "            except IndexError:\n",
    "                print(\"Invalid index!\")\n",
    "\n",
    "    elif menu_selection == 5:\n",
    "        if data_store == []:\n",
    "            print(\"Array is empty!\")\n",
    "        else:\n",
    "            target_index = int(input(\"Enter index to delete: \"))\n",
    "            try:\n",
    "                removed_item = data_store[target_index]\n",
    "                del data_store[target_index]\n",
    "                print(f\"{removed_item} deleted successfully!\")\n",
    "            except IndexError:\n",
    "                print(\"Invalid index!\")\n",
    "\n",
    "    elif menu_selection == 6:\n",
    "        print(\"Thank you! Program terminated.\")\n",
    "        break\n",
    "\n",
    "    else:\n",
    "        print(\"Invalid choice! Please enter a number between 1 and 6.\")"
   ]
  },
