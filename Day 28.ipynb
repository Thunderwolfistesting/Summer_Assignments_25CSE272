    "110. Write a program to Create bank account system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cc76dbe4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "    BANK ACCOUNT SYSTEM \n",
      "    1. Deposit\n",
      "    2. Withdraw\n",
      "    3. Check Balance\n",
      "    4. Account Details\n",
      "    5. Exit\n",
      "    \n",
      "₹1500.0 deposited successfully.\n",
      "Current Balance: ₹1500.0\n",
      "\n",
      "    BANK ACCOUNT SYSTEM \n",
      "    1. Deposit\n",
      "    2. Withdraw\n",
      "    3. Check Balance\n",
      "    4. Account Details\n",
      "    5. Exit\n",
      "    \n",
      "Thank you for using the Bank Account System.\n"
     ]
    }
   ],
   "source": [
    "owner_name = input(\"Enter Account Holder Name: \")\n",
    "account_id = input(\"Enter Account Number: \")\n",
    "current_funds = 0.0\n",
    "\n",
    "while True:\n",
    "    interface_menu = f\"\"\"\n",
    "    BANK ACCOUNT SYSTEM \n",
    "    1. Deposit\n",
    "    2. Withdraw\n",
    "    3. Check Balance\n",
    "    4. Account Details\n",
    "    5. Exit\n",
    "    \"\"\"\n",
    "    print(interface_menu)\n",
    "\n",
    "    user_choice = input(\"Enter your choice: \")\n",
    "\n",
    "    if user_choice == \"1\":\n",
    "        deposit_value = float(input(\"Enter deposit amount: \"))\n",
    "        current_funds += deposit_value\n",
    "        print(f\"₹{deposit_value} deposited successfully.\")\n",
    "        print(f\"Current Balance: ₹{current_funds}\")\n",
    "\n",
    "    elif user_choice == \"2\":\n",
    "        withdrawal_value = float(input(\"Enter withdrawal amount: \"))\n",
    "        if withdrawal_value <= current_funds:\n",
    "            current_funds -= withdrawal_value\n",
    "            print(f\"₹{withdrawal_value} withdrawn successfully.\")\n",
    "            print(f\"Current Balance: ₹{current_funds}\")\n",
    "        else:\n",
    "            print(\"Insufficient balance.\")\n",
    "\n",
    "    elif user_choice == \"3\":\n",
    "        print(f\"Current Balance: ₹{current_funds}\")\n\n",
    "    elif user_choice == \"4\":\n",
    "        account_summary = f\"\"\"\n",
    "    ----- Account Details -----\n",
    "    Account Holder : {owner_name}\n",
    "    Account Number : {account_id}\n",
    "    Balance        : ₹{current_funds}\n",
    "    ---------------------------\n",
    "        \"\"\"\n",
    "        print(account_summary)\n\n",
    "    elif user_choice == \"5\":\n",
    "        print(\"Thank you for using the Bank Account System.\")\n",
    "        break\n",
    "    else:\n",
    "        print(\"Invalid choice. Please try again.\")"
   ]
  },
