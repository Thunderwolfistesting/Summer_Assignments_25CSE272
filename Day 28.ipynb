    "111. Write a program to Create ticket booking system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7cdcdd73",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "===== Ticket Booking System =====\n",
      "\n",
      "----- Booking Details -----\n",
      "Customer Name : Julia\n",
      "Tickets Booked: 2\n",
      "Price per Ticket: ₹200\n",
      "Total Amount: ₹400\n",
      "Tickets Left: 48\n",
      "Booking Successful!\n"
     ]
    }
   ],
   "source": [
    "cost_per_seat = 200\n",
    "seats_remaining = 50\n",
    "\n",
    "print(\"===== Ticket Booking System =====\")\n",
    "\n",
    "client_name = input(\"Enter your name: \")\n",
    "requested_seats = int(input(\"Enter number of tickets: \"))\n",
    "\n",
    "if requested_seats <= 0:\n",
    "    print(\"Invalid number of tickets.\")\n",
    "elif requested_seats > seats_remaining:\n",
    "    print(f\"Sorry {client_name}, only {seats_remaining} tickets are available.\")\n",
    "else:\n",
    "    total_cost = requested_seats * cost_per_seat\n",
    "    seats_remaining -= requested_seats\n",
    "\n",
    "    print(\"\\n----- Booking Details -----\")\n",
    "    print(f\"Customer Name : {client_name}\")\n",
    "    print(f\"Tickets Booked: {requested_seats}\")\n",
    "    print(f\"Price per Ticket: ₹{cost_per_seat}\")\n",
    "    print(f\"Total Amount: ₹{total_cost}\")\n",
    "    print(f\"Tickets Left: {seats_remaining}\")\n",
    "    print(\"Booking Successful!\")"
   ]
  },
