   "source": [
    "109. Write a program to Create library management system."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "f08901b8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n",
      "--- LIBRARY MANAGEMENT SYSTEM ---\n",
      "1. Add Book\n",
      "2. View Books\n",
      "3. Search Book\n",
      "4. Issue Book\n",
      "5. Exit\n",
      "Book 'The Hobbit' added successfully.\n",
      "\n",
      "--- LIBRARY MANAGEMENT SYSTEM ---\n",
      "1. Add Book\n",
      "2. View Books\n",
      "3. Search Book\n",
      "4. Issue Book\n",
      "5. Exit\n",
      "1. The Hobbit | J.R.R. Tolkien | Available\n",
      "\n",
      "--- LIBRARY MANAGEMENT SYSTEM ---\n",
      "1. Add Book\n",
      "2. View Books\n",
      "3. Search Book\n",
      "4. Issue Book\n",
      "5. Exit\n",
      "Thank you!\n"
     ]
    }
   ],
   "source": [
    "catalog = []\n",
    "total_books = 0\n",
    "\n",
    "while True:\n",
    "    print(\"\\n--- LIBRARY MANAGEMENT SYSTEM ---\")\n",
    "    print(\"1. Add Book\")\n",
    "    print(\"2. View Books\")\n",
    "    print(\"3. Search Book\")\n",
    "    print(\"4. Issue Book\")\n",
    "    print(\"5. Exit\")\n",
    "\n",
    "    user_choice = input(\"Enter your choice: \")\n",
    "\n",
    "    if user_choice == \"1\":\n",
    "        book_title = input(\"Enter book title: \")\n",
    "        author_name = input(\"Enter author name: \")\n",
    "\n",
    "        catalog.append([book_title, author_name, \"Available\"])\n",
    "        total_books += 1\n",
    "        print(f\"Book '{book_title}' added successfully.\")\n",
    "\n",
    "    elif user_choice == \"2\":\n",
    "        if total_books == 0:\n",
    "            print(\"No books in library.\")\n",
    "        else:\n",
    "            idx = 0\n",
    "            while idx < total_books:\n",
    "                print(f\"{idx + 1}. {catalog[idx][0]} | {catalog[idx][1]} | {catalog[idx][2]}\")\n",
    "                idx += 1\n",
    "\n",
    "    elif user_choice == \"3\":\n",
    "        book_title = input(\"Enter book title: \")\n",
    "        is_found = False\n",
    "\n",
    "        idx = 0\n",
    "        while idx < total_books:\n",
    "            if catalog[idx][0] == book_title:\n",
    "                print(f\"Title : {catalog[idx][0]}\")\n",
    "                print(f\"Author: {catalog[idx][1]}\")\n",
    "                print(f\"Status: {catalog[idx][2]}\")\n",
    "                is_found = True\n",
    "                break\n",
    "            idx += 1\n",
    "\n",
    "        if not is_found:\n",
    "            print(\"Book not found.\")\n",
    "\n",
    "    elif user_choice == \"4\":\n",
    "        book_title = input(\"Enter book title: \")\n",
    "        is_found = False\n",
    "\n",
    "        idx = 0\n",
    "        while idx < total_books:\n",
    "            if catalog[idx][0] == book_title:\n",
    "                is_found = True\n",
    "                if catalog[idx][2] == \"Available\":\n",
    "                    catalog[idx][2] = \"Issued\"\n",
    "                    print(\"Book issued successfully.\")\n",
    "                else:\n",
    "                    print(\"Book already issued.\")\n",
    "                break\n",
    "            idx += 1\n",
    "\n",
    "        if not is_found:\n",
    "            print(\"Book not found.\")\n",
    "\n",
    "    elif user_choice == \"5\":\n",
    "        print(\"Thank you!\")\n",
    "        break\n",
    "    else:\n",
    "        print(\"Invalid choice.\")"
   ]
  },
